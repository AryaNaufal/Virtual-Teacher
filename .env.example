# Salin menjadi .env.local lalu isi. Jangan commit .env.local.

# -- Penyedia AI (hanya dipakai di server) ------------------------------------
# Isi kunci SATU atau lebih penyedia. Aplikasi memilih otomatis:
#   1. AI_PROVIDER bila diisi (openai | gemini | anthropic | custom)
#   2. AI_API_KEY bila diisi (penyedia ditebak dari AI_BASE_URL; format konfigurasi lama)
#   3. kunci yang ditemukan, urutan: OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY
# Tanpa kunci apa pun: perintah memakai aturan kata kunci; materi/soal/esai/gambar menampilkan pesan butuh kunci.

# ChatGPT (platform.openai.com/api-keys, berbayar)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini (aistudio.google.com/apikey, ada tier gratis berbatas)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Nama model Gemini berubah cepat; model lama bisa ditutup untuk pengguna baru (404).
# Daftar model aktif: GET https://generativelanguage.googleapis.com/v1beta/models dengan header x-goog-api-key.

# Claude (console.anthropic.com, berbayar; langganan Claude.ai TIDAK termasuk kredit API)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Memilih penyedia secara eksplisit bila beberapa kunci terisi:
# AI_PROVIDER=gemini

# Opsional
# AI_MIN_INTERVAL_MS=4000     # jeda minimal antar permintaan AI (anti-RPM). Bawaan: Gemini 4000, lainnya 0. Naikkan bila sering kena 429
# AI_VISION_MODEL=            # model untuk membaca gambar (bawaan: sama dengan model biasa)
# AI_REASONING_EFFORT=off     # Gemini 3.x memakai "none" secara otomatis agar cepat; "off" mematikan pengiriman parameter ini

# -- "Otak" tiap karyawan dari model gratis (OpenRouter) ------------------------
# Satu kunci OpenRouter (openrouter.ai/keys) cukup untuk semua karyawan. Model berakhiran :free tidak berbayar tetapi dibatasi
# permintaan per menit/hari; karena itu tiap karyawan diberi DAFTAR model (dipisah koma): yang pertama dicoba dulu, bila sibuk
# (429/503/404) otomatis pindah ke berikutnya. Maksimal 4 model per karyawan.
# Yang memakai AI hanya: manager (memilih agen), content (materi), assignment (soal), checker (koreksi esai), paper (Korektor Paper), archivist (baca gambar).
# Karyawan lain (administrator, attendance, grading, reporting) menghitung langsung dari data, tanpa model.
# Daftar model gratis berubah cepat; lihat yang aktif: https://openrouter.ai/api/v1/models (pricing.prompt = 0)
# Catatan privasi: penyedia model gratis dapat menyimpan/memakai prompt; jangan kirim data siswa yang sensitif.
#
# AI_PROVIDER=custom
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free                       # model umum / cadangan terakhir (router otomatis OpenRouter)
# AI_MODEL_FALLBACKS=openrouter/free             # ditambahkan di akhir rantai semua karyawan
# AI_MODEL_MANAGER=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free        # butuh tool calling
# AI_MODEL_CONTENT=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free        # tulisan panjang
# AI_MODEL_ASSIGNMENT=google/gemma-4-31b-it:free,inclusionai/ling-3.2-flash:free            # soal + kunci
# AI_MODEL_CHECKER=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free        # koreksi esai (JSON konsisten)
# AI_MODEL_PAPER=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free            # Korektor Paper: paper panjang, JSON rapi
# AI_MODEL_ARCHIVIST=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free           # harus bisa membaca gambar
# Hermes sebagai satu "otak" (opsional): AI_BASE_URL=http://127.0.0.1:8642/v1, AI_MODEL=hermes-agent (lihat README)

# Penyedia lain yang kompatibel OpenAI (Groq, OpenRouter, Ollama lokal):
# AI_PROVIDER=custom
# AI_API_KEY=isi-kunci-atau-ollama
# AI_BASE_URL=https://api.groq.com/openai/v1      (Groq)
# AI_BASE_URL=https://openrouter.ai/api/v1        (OpenRouter)
# AI_BASE_URL=http://localhost:11434/v1           (Ollama)
# AI_MODEL=nama-model

# -- Database MySQL / MariaDB (XAMPP) ------------------------------------------
# Aktifkan login + penyimpanan di database: isi blok ini, jalankan 
pm run db:setup, lalu restart server.
# Kosongkan NEXT_PUBLIC_DB_ENABLED untuk "mode lokal" (tanpa login, data di browser).
NEXT_PUBLIC_DB_ENABLED=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_teacher_office
# Tambahkan MYSQL_ADMIN_USER / MYSQL_ADMIN_PASSWORD hanya bila database belum dibuat dan user di atas tidak berhak membuatnya.
# Rahasia penanda tangan sesi login (acak, min. 16 karakter; buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=